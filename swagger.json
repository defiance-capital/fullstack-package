  "info": {
    "title": "Fullstack Homework API",
    "description": "",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "LoginReq": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          }
        },
        "required": [
          "username"
        ]
      },
      "LoginResult": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "expiresIn": {
            "type": "number",
            "default": 86400
          },
          "user": {
            "type": "object"
          }
        },
        "required": [
          "accessToken",
          "expiresIn",
          "user"
        ]
      },
      "GetLeaveBalanceResult": {
        "type": "object",
        "properties": {
          "balance": {
            "type": "number",
            "default": 12
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "balance",
          "updatedAt"
        ]
      },
      "GetLeaveRequestResultItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "default": 1
          },
          "description": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "ANNUAL",
              "SICK",
              "UNPAID"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "APPROVED",
              "REJECTED"
            ]
          },
          "startDate": {
            "format": "date-time",
            "type": "string"
          },
          "endDate": {
            "format": "date-time",
            "type": "string"
          },
          "leaveDays": {
            "type": "number",
            "default": 1
          },
          "creatorId": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "description",
          "type",
          "status",
          "startDate",
          "endDate",
          "leaveDays",
          "creatorId"
        ]
      },
      "GetLeaveRequestResult": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GetLeaveRequestResultItem"
            }
          }
        },
        "required": [
          "items"
        ]
      },
      "HandleLeaveRequestReq": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "APPROVE",
              "REJECT"
            ]
          }
        },
        "required": [
          "action"
        ]
      },
      "CreateLeaveRequestReq": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "ANNUAL",
              "SICK",
              "UNPAID"
            ]
          },
          "startDate": {
            "format": "date-time",
            "type": "string"
          },
          "leaveDays": {
            "type": "number",
            "minimum": 1
          }
        },
        "required": [
          "description",
          "type",
          "startDate",
          "leaveDays"
        ]
      },
      "CreateLeaveRequestResult": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "default": 1
          },
          "description": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "ANNUAL",
              "SICK",
              "UNPAID"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "APPROVED",
              "REJECTED"
            ]
          },
          "startDate": {
            "format": "date-time",
            "type": "string"
          },
          "endDate": {
            "format": "date-time",
            "type": "string"
          },
          "leaveDays": {
            "type": "number",
            "default": 1
          }
        },
        "required": [
          "id",
          "description",
          "type",
          "status",
          "startDate",
          "endDate",
          "leaveDays"
        ]
      },
      "SuccessResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "type": "object"
          }
        },
        "required": [
          "success",
          "data"
        ]
      },
      "InternalServerErrorResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "errorCode": {
            "type": "string",
            "example": "INTERNAL_SERVER_ERROR"
          },
          "message": {
            "type": "string",
            "example": "An unexpected error occurred"
          }
        },
        "required": [
          "success",
          "errorCode",
          "message"
        ]
      }
    }
  }
}