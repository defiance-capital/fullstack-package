    "/api/v1/leave-request": {
      "get": {
        "operationId": "AppController_getLeaveRequest_v1",
        "parameters": [
          {
            "name": "status",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "PENDING",
                "APPROVED",
                "REJECTED"
              ]
            }
          },
          {
            "name": "startDate",
            "required": false,
            "in": "query",
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          },
          {
            "name": "endDate",
            "required": false,
            "in": "query",
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          },
          {
            "name": "sortBy",
            "required": true,
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "status",
                "startDate"
              ]
            }
          },
          {
            "name": "sortDir",
            "required": true,
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
